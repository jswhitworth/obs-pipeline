          <mxGeometry x="58" y="394" width="228" height="34" as="geometry" />
        </mxCell>
        <mxCell id="rhash" value="&lt;b&gt;all 8 canonicalized + hashed → rules_rollup&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5E08A;strokeColor=#B39A2E;fontSize=10;align=center;verticalAlign=middle;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="58" y="434" width="228" height="32" as="geometry" />
        </mxCell>
        <mxCell id="obs" value="&lt;b&gt;obs-data/observations.csv&lt;/b&gt;&lt;br&gt;74 raw observations" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFF0B3;strokeColor=#B39A2E;fontSize=12;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="264" height="66" as="geometry" />
        </mxCell>
        <mxCell id="tracer" value="trace.py · Tracer  —  Traced[T] cannot be constructed except through Tracer.step(), so a code path that produces a value necessarily emitted one.  step_id is content-addressed, never a counter." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B9D2F2;strokeColor=#3B6BA5;horizontal=0;fontSize=11;fontStyle=1;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="346" y="132" width="36" height="1058" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1.  load_rules&lt;/b&gt;   &lt;i&gt;loader.py&lt;/i&gt;&lt;br&gt;Parse 6 YAML + vocab · cross-file validation raises CrossFileError at init, not three stages later · per-file + rollup hash · stale-bump check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="398" y="132" width="322" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2.  load_observations&lt;/b&gt;   &lt;i&gt;extract.py + normalize.py&lt;/i&gt;&lt;br&gt;regex / OUI map / port signatures → MAC, hostname, vendor, device_type canonicalization · absence emits no_extraction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="398" y="238" width="322" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3.  build_claims&lt;/b&gt;   &lt;i&gt;claims.py&lt;/i&gt;&lt;br&gt;keyed (obs_id, field | link_basis, value) · source is metadata ON the claim, never in the key · NOT vocab-constrained · absence emits no_identity_claim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="398" y="344" width="322" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4.  resolve_entities&lt;/b&gt;   &lt;i&gt;entity.py&lt;/i&gt;&lt;br&gt;deterministic union-find · merge order pinned by entity_resolution.yaml, not by input order · basis-precedence tie-break · content-addressed entity_id · refusals emit merge_refused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="398" y="450" width="322" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5.  resolve_fields&lt;/b&gt;   &lt;i&gt;fields.py&lt;/i&gt;&lt;br&gt;entity level · highest claim_weight wins · winner re-scored over POOLED witness groups across members · firmware conflict → undecidable · out-of-vocab emits vocab_reject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="398" y="556" width="322" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6.  observation_fields&lt;/b&gt;   &lt;i&gt;fields.py&lt;/i&gt;&lt;br&gt;per observation · direct vs propagated provenance · multiplicative decay: source_conf × link_weight × decay_base^hop · Unknown never propagates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="398" y="662" width="322" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;7.  entity_confidence + stability&lt;/b&gt;   &lt;i&gt;confidence.py&lt;/i&gt;&lt;br&gt;harmonic mean across fields — the weakest field dominates · stability is a SEPARATE measure: margin, witness_dependence (a count), live_conflict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="398" y="768" width="322" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;8.  write_bundle&lt;/b&gt;   &lt;i&gt;bundle.py&lt;/i&gt;&lt;br&gt;manifest + 4 CSVs + trace.jsonl · rows stay narrow: each carries run_id and derivation_step rather than repeating rule versions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="398" y="874" width="322" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;b&gt;9.  emit_metrics&lt;/b&gt;   &lt;i&gt;metrics.py&lt;/i&gt;&lt;br&gt;label-free metrics only · long format, one row per measurement, n mandatory · appended to runs/history.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="398" y="980" width="322" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;b&gt;10.  write_report&lt;/b&gt;   &lt;i&gt;report.py&lt;/i&gt;&lt;br&gt;REPORT.md is a derived render — regenerable, never hand-edited, and nothing may depend on parsing it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="398" y="1086" width="322" height="90" as="geometry" />
        </mxCell>
        <mxCell id="score" value="&lt;b&gt;scoring.py · score()&lt;/b&gt;&lt;br&gt;THE single scoring function.&lt;br&gt;&lt;br&gt;clamp(max_base + independence_bonus − conflict_penalty, 0, 1)&lt;br&gt;&lt;br&gt;Three coefficient sets, one formula shape." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFDDB0;strokeColor=#B87A00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="748" y="356" width="150" height="210" as="geometry" />
