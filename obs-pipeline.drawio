        </mxCell>
        <mxCell id="tracer" value="trace.py · Tracer  —  Traced[T] cannot be constructed except through Tracer.step(), so a code path that produces a value necessarily emitted one. step_id is content-addressed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D4E1F5;strokeColor=#6C8EBF;horizontal=0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="345" y="130" width="34" height="920" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="1.  load_rules&lt;br&gt;loader.py&lt;br&gt;Parse 6 YAML + vocab · cross-file validation raises CrossFileError at init, not three stages later · per-file + rollup hash · stale-bump check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="392" y="130" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2.  load_observations&lt;br&gt;extract.py + normalize.py&lt;br&gt;regex / OUI map / port signatures → MAC, hostname, vendor, device_type canonicalization · absence emits no_extraction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="392" y="222" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3.  build_claims&lt;br&gt;claims.py&lt;br&gt;keyed (obs_id, field | link_basis, value) · source is metadata ON the claim, never in the key · NOT vocab-constrained · absence emits no_identity_claim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="392" y="314" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4.  resolve_entities&lt;br&gt;entity.py&lt;br&gt;deterministic union-find · merge order pinned by entity_resolution.yaml, not by input order · basis-precedence tie-break · content-addressed entity_id · refusals emit merge_refused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="392" y="406" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5.  resolve_fields&lt;br&gt;fields.py&lt;br&gt;entity level · highest claim_weight wins · winner re-scored over POOLED witness groups across members · firmware conflict → undecidable · out-of-vocab emits vocab_reject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="392" y="498" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6.  observation_fields&lt;br&gt;fields.py&lt;br&gt;per observation · direct vs propagated provenance · multiplicative decay: source_conf × link_weight × decay_base^hop · Unknown never propagates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="392" y="590" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7.  entity_confidence + stability&lt;br&gt;confidence.py&lt;br&gt;harmonic mean across fields — weakest field dominates · stability is a SEPARATE measure: margin, witness_dependence (a count), live_conflict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="392" y="682" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="8.  write_bundle&lt;br&gt;bundle.py&lt;br&gt;manifest + 4 CSVs + trace.jsonl · rows stay narrow: each carries run_id and derivation_step rather than repeating rule versions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="392" y="774" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="9.  emit_metrics&lt;br&gt;metrics.py&lt;br&gt;label-free metrics only · long format, one row per measurement, n mandatory · appended to runs/history.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="392" y="866" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="10.  write_report&lt;br&gt;report.py&lt;br&gt;REPORT.md is a derived render — regenerable, never hand-edited, nothing may depend on parsing it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="392" y="958" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="score" value="scoring.py · score()&lt;br&gt;THE single scoring function.&lt;br&gt;claim_weight = clamp(max_base + independence_bonus − conflict_penalty, 0, 1)&lt;br&gt;3 coefficient sets, one formula." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="744" y="330" width="146" height="150" as="geometry" />
        </mxCell>
