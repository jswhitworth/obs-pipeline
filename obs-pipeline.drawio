        <mxCell id="b6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CDE8C9;strokeColor=#5D9152;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;metrics.jsonl&lt;/b&gt;&lt;br&gt;label-free metrics" vertex="1">
          <mxGeometry height="42" width="238" x="987" y="446" as="geometry" />
        </mxCell>
        <mxCell id="b7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CDE8C9;strokeColor=#5D9152;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;REPORT.md&lt;/b&gt;&lt;br&gt;derived render" vertex="1">
          <mxGeometry height="42" width="238" x="987" y="496" as="geometry" />
        </mxCell>
        <mxCell id="l0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4D3EE;strokeColor=#7A5091;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;fontColor=#101010;" value="&lt;b&gt;labels-initial.csv&lt;/b&gt;  (wide)" vertex="1">
          <mxGeometry height="32" width="228" x="58" y="644" as="geometry" />
        </mxCell>
        <mxCell id="l1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4D3EE;strokeColor=#7A5091;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;fontColor=#101010;" value="&lt;b&gt;labels.csv&lt;/b&gt;  (long, authoritative)" vertex="1">
          <mxGeometry height="32" width="228" x="58" y="680" as="geometry" />
        </mxCell>
        <mxCell id="l2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4D3EE;strokeColor=#7A5091;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;fontColor=#101010;" value="&lt;b&gt;VERSION&lt;/b&gt;" vertex="1">
          <mxGeometry height="32" width="228" x="58" y="716" as="geometry" />
        </mxCell>
        <mxCell id="l3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4D3EE;strokeColor=#7A5091;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;fontColor=#101010;" value="archive/&amp;lt;version&amp;gt;-labels.csv" vertex="1">
          <mxGeometry height="32" width="228" x="58" y="752" as="geometry" />
        </mxCell>
        <mxCell id="l4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4D3EE;strokeColor=#7A5091;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;fontColor=#101010;" value="journal.jsonl" vertex="1">
          <mxGeometry height="32" width="228" x="58" y="788" as="geometry" />
        </mxCell>
        <mxCell id="l5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4D3EE;strokeColor=#7A5091;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;fontColor=#101010;" value="last_label_state.json" vertex="1">
          <mxGeometry height="32" width="228" x="58" y="824" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D6;strokeColor=#A33A30;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;invariant #4 — rule-state traceability&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every output binds to the exact rule state via run_id → manifest.json. engine_commit carries a -dirty suffix when the tree was not clean, because a clean sha reported while uncommitted code actually ran is worse than no value at all." vertex="1">
          <mxGeometry height="150" width="322" x="1248" y="130" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D6;strokeColor=#A33A30;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;invariant #1 — DAG discipline&lt;/b&gt;&lt;br&gt;&lt;br&gt;Entity resolution reads identity claims ONLY, never resolved field values. There is no field → cluster feedback loop, which is what keeps the pipeline a strict DAG and keeps replay meaningful." vertex="1">
          <mxGeometry height="150" width="322" x="1248" y="294" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D6;strokeColor=#A33A30;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;invariant #3 — scoring parity&lt;/b&gt;&lt;br&gt;&lt;br&gt;One scoring function, used by claim construction, entity resolution and the cross-observation re-score. Coefficients may differ per claim type; the formula shape may not. Do not write a second implementation." vertex="1">
          <mxGeometry height="150" width="322" x="1248" y="458" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D6;strokeColor=#A33A30;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;invariant #7 — no output without a derivation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Enforced mechanically by replay.py, not by convention. Absence needs a step too: no_extraction, no_identity_claim, vocab_reject and merge_refused are first-class steps, not silences." vertex="1">
          <mxGeometry height="150" width="322" x="1248" y="622" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D6;strokeColor=#A33A30;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;determinism&lt;/b&gt;&lt;br&gt;&lt;br&gt;No reliance on dict ordering, input row order, or wall clock anywhere in the pipeline path. run_id carries the only timestamp and no decision reads it. Two runs over identical input produce byte-identical trace.jsonl." vertex="1">
          <mxGeometry height="150" width="322" x="1248" y="786" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D6;strokeColor=#A33A30;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;three combining operations, never conflated&lt;/b&gt;&lt;br&gt;&lt;br&gt;same value witnessed twice → max + saturating bonus (scoring.py)&lt;br&gt;a propagation chain → multiplicative (fields.py)&lt;br&gt;different fields into one record → harmonic mean (confidence.py)" vertex="1">
          <mxGeometry height="150" width="322" x="1248" y="950" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Surfaces" id="surfaces">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="The five surfaces — what each is for" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="t2s" value="Each is a standalone entry point. None is a flag on another. Run everything from the repo root." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#2E2E2E;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1100" height="22" as="geometry" />
        </mxCell>
        <mxCell id="h0" value="SURFACE" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#101010;align=left;spacingLeft=9;" vertex="1" parent="1">
          <mxGeometry x="40" y="96" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="READS" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#101010;align=left;spacingLeft=9;" vertex="1" parent="1">
          <mxGeometry x="352" y="96" width="250" height="24" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="DOES" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#101010;align=left;spacingLeft=9;" vertex="1" parent="1">
          <mxGeometry x="614" y="96" width="430" height="24" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="WRITES" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#101010;align=left;spacingLeft=9;" vertex="1" parent="1">
          <mxGeometry x="1056" y="96" width="250" height="24" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="USE IT WHEN" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#101010;align=left;spacingLeft=9;" vertex="1" parent="1">
          <mxGeometry x="1318" y="96" width="262" height="24" as="geometry" />
        </mxCell>
        <mxCell id="run_s" value="&lt;b&gt;run.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;python3 run.py&lt;br&gt;python3 run.py &amp;lt;obs.csv&amp;gt; &amp;lt;rules_dir&amp;gt; &amp;lt;out_root&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232323;strokeColor=none;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="126" width="300" height="184" as="geometry" />
        </mxCell>
        <mxCell id="run_r" value="rules/&lt;br&gt;obs-data/observations.csv&lt;br&gt;&lt;br&gt;&lt;b&gt;NEVER labels/&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3E3;strokeColor=#5D9152;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="352" y="126" width="250" height="184" as="geometry" />
        </mxCell>
        <mxCell id="run_d" value="Runs the ten stages on page 1 and writes a self-describing bundle. Two runs over unchanged input and rules are byte-identical — so re-running to see whether something changed tells you nothing." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="614" y="126" width="430" height="184" as="geometry" />
        </mxCell>
        <mxCell id="run_w" value="runs/&amp;lt;run_id&amp;gt;/&lt;br&gt;runs/history.jsonl&lt;br&gt;runs/last_rules_state.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3E3;strokeColor=#5D9152;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="1056" y="126" width="250" height="184" as="geometry" />
        </mxCell>
        <mxCell id="run_u" value="You changed a rule, or you want fresh output.&lt;br&gt;&lt;br&gt;This is the golden path; every other surface consumes what it writes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="1318" y="126" width="262" height="184" as="geometry" />
        </mxCell>
        <mxCell id="replay_s" value="&lt;b&gt;replay.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;python3 replay.py runs/&amp;lt;run_id&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232323;strokeColor=none;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="324" width="300" height="184" as="geometry" />
        </mxCell>
        <mxCell id="replay_r" value="runs/&amp;lt;run_id&amp;gt;/trace.jsonl&lt;br&gt;&lt;br&gt;&lt;b&gt;NEVER the engine&lt;/b&gt; — an AST test forbids importing scoring / entity / fields" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3E3;strokeColor=#5D9152;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="352" y="324" width="250" height="184" as="geometry" />
        </mxCell>
        <mxCell id="replay_d" value="Reconstructs claims.csv, membership.csv and entities.csv from the trace ALONE, then diffs against what actually shipped. If it could reach the engine it might recompute a value instead of reading it, and the gate would pass on an incomplete trace." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="614" y="324" width="430" height="184" as="geometry" />
        </mxCell>
        <mxCell id="replay_w" value="stdout: REPLAY OK&lt;br&gt;exit 1 + the diff on any hole" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3E3;strokeColor=#5D9152;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="1056" y="324" width="250" height="184" as="geometry" />
        </mxCell>
        <mxCell id="replay_u" value="After ANY change touching trace emission.&lt;br&gt;&lt;br&gt;It is cheap, and it is the only thing that catches a silently broken audit trail." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="1318" y="324" width="262" height="184" as="geometry" />
        </mxCell>
        <mxCell id="eval_s" value="&lt;b&gt;eval.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;python3 eval.py&lt;br&gt;python3 eval.py &amp;lt;obs&amp;gt; &amp;lt;rules&amp;gt; &amp;lt;labels&amp;gt; &amp;lt;out&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232323;strokeColor=none;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="522" width="300" height="184" as="geometry" />
        </mxCell>
        <mxCell id="eval_r" value="rules/ &lt;b&gt;AND&lt;/b&gt; labels/&lt;br&gt;&lt;br&gt;The only component that reads both sides. Invokes run_pipeline as a black box." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6D9;strokeColor=#B39A2E;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="352" y="522" width="250" height="184" as="geometry" />
        </mxCell>
        <mxCell id="eval_d" value="Scores the run against ground truth. Four-bucket diff (fixed / broken / stable_correct / stable_incorrect) per label, because aggregate metrics hide cases a rule change silently broke. Raises LabelsMovedError BEFORE writing anything if the label set moved — a moved label must never read as a rule regression." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="614" y="522" width="430" height="184" as="geometry" />
        </mxCell>
        <mxCell id="eval_w" value="evals/&amp;lt;eval_id&amp;gt;/&lt;br&gt;   outcomes.json&lt;br&gt;   metrics.jsonl&lt;br&gt;   regressions.csv&lt;br&gt;   eval_manifest.json&lt;br&gt;+ re-renders REPORT.md" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6D9;strokeColor=#B39A2E;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="1056" y="522" width="250" height="184" as="geometry" />
        </mxCell>
        <mxCell id="eval_u" value="You want accuracy, or you want to know what a rule change actually moved.&lt;br&gt;&lt;br&gt;Regressions are LOGGED, not blocked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="1318" y="522" width="262" height="184" as="geometry" />
        </mxCell>
        <mxCell id="labeltools_s" value="&lt;b&gt;label_tools.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;python3 label_tools.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232323;strokeColor=none;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="300" height="184" as="geometry" />
        </mxCell>
        <mxCell id="labeltools_r" value="labels/labels-initial.csv&lt;br&gt;obs-data/observations.csv&lt;br&gt;claims.yaml#fields (passed in at the entry point)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1E9F6;strokeColor=#7A5091;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="352" y="720" width="250" height="184" as="geometry" />
        </mxCell>
        <mxCell id="labeltools_d" value="Converts the wide rendering into the long-format labels.csv everything else reads, and runs the transitivity check. Refuses to regenerate over adjudicated labels, and refuses a column that is neither wide-file metadata nor a declared field — a silently ignored column drops that field&#39;s whole ground truth." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="614" y="720" width="430" height="184" as="geometry" />
        </mxCell>
        <mxCell id="labeltools_w" value="labels/labels.csv&lt;br&gt;labels/VERSION&lt;br&gt;labels/archive/&lt;br&gt;labels/journal.jsonl&lt;br&gt;labels/last_label_state.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1E9F6;strokeColor=#7A5091;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="1056" y="720" width="250" height="184" as="geometry" />
        </mxCell>
        <mxCell id="labeltools_u" value="You edited labels-initial.csv.&lt;br&gt;&lt;br&gt;labels.csv is generated, never maintained by hand." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="1318" y="720" width="262" height="184" as="geometry" />
        </mxCell>
        <mxCell id="adj_s" value="&lt;b&gt;adjudicate.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;python3 adjudicate.py runs/&amp;lt;run_id&amp;gt;&lt;br&gt;python3 adjudicate.py runs/&amp;lt;run_id&amp;gt; returned.csv" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232323;strokeColor=none;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="918" width="300" height="184" as="geometry" />
        </mxCell>
        <mxCell id="adj_r" value="resolutions.csv — read only to EXCLUDE what is already settled&lt;br&gt;labels/labels.csv&lt;br&gt;claims.yaml#fields" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1E9F6;strokeColor=#7A5091;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="352" y="918" width="250" height="184" as="geometry" />
        </mxCell>
        <mxCell id="adj_d" value="&lt;b&gt;EXPORT&lt;/b&gt;: an evidence-only packet for the medium/low certainty stratum — no resolved values, no confidence, so the adjudicator is asked &amp;quot;what is this?&amp;quot; rather than &amp;quot;is this right?&amp;quot;.&lt;br&gt;&lt;b&gt;IMPORT&lt;/b&gt;: two independent gates — rejected (inadmissible) and refused (does not supersede, per basis precedence)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="614" y="918" width="430" height="184" as="geometry" />
        </mxCell>
        <mxCell id="adj_w" value="adjudication/&amp;lt;run_id&amp;gt;/packet.csv&lt;br&gt;&lt;br&gt;then, on import, all of labels/ above" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1E9F6;strokeColor=#7A5091;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="1056" y="918" width="250" height="184" as="geometry" />
        </mxCell>
        <mxCell id="adj_u" value="You need better ground truth where the labeller was unsure.&lt;br&gt;&lt;br&gt;An observation leaves the queue only when EVERY row it has is settled." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontSize=11;align=left;spacingLeft=9;verticalAlign=top;spacingTop=8;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="1318" y="918" width="262" height="184" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="&lt;b&gt;The two guard rails, and why they point in opposite directions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;invariant #5 — labels never enter the runtime path.&lt;/b&gt;  run.py and everything it imports have no code path that reads labels/. This is why eval.py, label_tools.py and adjudicate.py live OUTSIDE obs_pipeline/: structural, not conventional. It is what stops the pipeline from doing better on labelled data than it would on new data.&lt;br&gt;&lt;br&gt;&lt;b&gt;invariant #6 — pipeline output never enters hard-stratum label creation.&lt;/b&gt;  The mirror. In adjudicate.py, SELECTION may read pipeline output; PRESENTATION must not. A human handed a plausible answer and asked &amp;quot;is this right?&amp;quot; agrees more often than one asked &amp;quot;what is this?&amp;quot;, and unblinded labelling drifts ground truth toward whatever the pipeline already believes — worst precisely where it is confidently wrong." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D6;strokeColor=#A33A30;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="40" y="1128" width="1540" height="186" as="geometry" />
        </mxCell>
        <mxCell id="order" value="&lt;b&gt;Everyday order:&lt;/b&gt;   python3 -m pytest -q   →   python3 eval.py   →   python3 replay.py runs/&amp;lt;run_id&amp;gt;   →   read regressions.csv   →   bump rules/VERSION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=12;align=center;verticalAlign=middle;fontColor=#101010;" vertex="1" parent="1">
          <mxGeometry x="40" y="1330" width="1540" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
