          <mxGeometry x="948" y="416" width="244" height="34" as="geometry" />
        </mxCell>
        <mxCell id="l0" value="labels-initial.csv  (wide)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="58" y="638" width="224" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="labels.csv  (long, authoritative)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="58" y="672" width="224" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="VERSION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="58" y="706" width="224" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="archive/&amp;lt;version&amp;gt;-labels.csv" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="58" y="740" width="224" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="journal.jsonl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="58" y="774" width="224" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="last_label_state.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="58" y="808" width="224" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="invariant #4 — rule-state traceability&lt;br&gt;&lt;br&gt;Every output binds to the exact rule state via run_id → manifest.json. engine_commit carries a -dirty suffix when the tree was not clean, because a clean sha reported while uncommitted code ran is worse than no value at all." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="128" width="320" height="128" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="invariant #1 — DAG discipline&lt;br&gt;&lt;br&gt;Entity resolution reads identity claims ONLY, never resolved field values. There is no field → cluster feedback loop, which is what keeps the pipeline a strict DAG and replay meaningful." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="270" width="320" height="128" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="invariant #3 — scoring parity&lt;br&gt;&lt;br&gt;One scoring function, used by claim construction, entity resolution and the cross-observation re-score. Coefficients may differ per claim type; the formula shape may not. Do not write a second implementation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="412" width="320" height="128" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="invariant #7 — no output without a derivation&lt;br&gt;&lt;br&gt;Enforced mechanically by replay.py, not by convention. Absence needs a step too: no_extraction, no_identity_claim, vocab_reject and merge_refused are first-class steps, not silences." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="554" width="320" height="128" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="determinism&lt;br&gt;&lt;br&gt;No reliance on dict ordering, input row order, or wall clock anywhere in the pipeline path. run_id carries the only timestamp and no decision reads it. Two runs over identical input produce byte-identical trace.jsonl." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="696" width="320" height="128" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="three combining operations, never conflated&lt;br&gt;&lt;br&gt;same value witnessed twice → max + saturating bonus (scoring.py) · a propagation chain → multiplicative (fields.py) · different fields into one record → harmonic mean (confidence.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="838" width="320" height="128" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Surfaces" id="surfaces">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="The five surfaces — what each is for" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2s" value="Each is a standalone entry point. None is a flag on another. Run everything from the repo root." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5A5A5A;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1000" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h0" value="SURFACE" style="text;html=1;fontSize=10;fontStyle=1;fontColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="96" width="300" height="26" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="READS" style="text;html=1;fontSize=10;fontStyle=1;fontColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="96" width="250" height="26" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="DOES" style="text;html=1;fontSize=10;fontStyle=1;fontColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="96" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="WRITES" style="text;html=1;fontSize=10;fontStyle=1;fontColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="96" width="250" height="26" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="USE IT WHEN" style="text;html=1;fontSize=10;fontStyle=1;fontColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1300" y="96" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="run_s" value="run.py&lt;br&gt;&lt;br&gt;python3 run.py&lt;br&gt;python3 run.py &amp;lt;obs.csv&amp;gt; &amp;lt;rules_dir&amp;gt; &amp;lt;out_root&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="126" width="300" height="168" as="geometry" />
        </mxCell>
        <mxCell id="run_r" value="rules/&lt;br&gt;obs-data/observations.csv&lt;br&gt;&lt;br&gt;NEVER labels/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF7EC;strokeColor=#82B366;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="126" width="250" height="168" as="geometry" />
        </mxCell>
        <mxCell id="run_d" value="Runs the 10 stages on page 1 and writes a self-describing bundle. Two runs over unchanged input and rules are byte-identical — re-running to see if something changed tells you nothing." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="610" y="126" width="420" height="168" as="geometry" />
        </mxCell>
        <mxCell id="run_w" value="runs/&amp;lt;run_id&amp;gt;/&lt;br&gt;runs/history.jsonl&lt;br&gt;runs/last_rules_state.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF7EC;strokeColor=#82B366;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1040" y="126" width="250" height="168" as="geometry" />
        </mxCell>
        <mxCell id="run_u" value="You changed a rule, or you want fresh output. This is the golden path; everything else consumes what it writes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1300" y="126" width="260" height="168" as="geometry" />
        </mxCell>
        <mxCell id="replay_s" value="replay.py&lt;br&gt;&lt;br&gt;python3 replay.py runs/&amp;lt;run_id&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="308" width="300" height="168" as="geometry" />
        </mxCell>
        <mxCell id="replay_r" value="runs/&amp;lt;run_id&amp;gt;/trace.jsonl&lt;br&gt;&lt;br&gt;NEVER the engine — an AST test forbids importing scoring / entity / fields" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF7EC;strokeColor=#82B366;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="308" width="250" height="168" as="geometry" />
        </mxCell>
        <mxCell id="replay_d" value="Reconstructs claims.csv, membership.csv and entities.csv from the trace ALONE, then diffs against what actually shipped. If it could reach the engine it might recompute a value instead of reading it, and the gate would pass on an incomplete trace." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="610" y="308" width="420" height="168" as="geometry" />
        </mxCell>
        <mxCell id="replay_w" value="stdout: REPLAY OK&lt;br&gt;exit 1 + the diff on any hole" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF7EC;strokeColor=#82B366;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1040" y="308" width="250" height="168" as="geometry" />
        </mxCell>
        <mxCell id="replay_u" value="After ANY change touching trace emission. It is cheap, and it is the only thing that catches a silently broken audit trail." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1300" y="308" width="260" height="168" as="geometry" />
        </mxCell>
        <mxCell id="eval_s" value="eval.py&lt;br&gt;&lt;br&gt;python3 eval.py&lt;br&gt;python3 eval.py &amp;lt;obs&amp;gt; &amp;lt;rules&amp;gt; &amp;lt;labels&amp;gt; &amp;lt;out&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="300" height="168" as="geometry" />
        </mxCell>
        <mxCell id="eval_r" value="rules/ AND labels/&lt;br&gt;&lt;br&gt;The only component that reads both sides. Invokes run_pipeline as a black box." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="490" width="250" height="168" as="geometry" />
        </mxCell>
        <mxCell id="eval_d" value="Scores the run against ground truth. Four-bucket diff (fixed / broken / stable_correct / stable_incorrect) per label, because aggregate metrics hide cases a rule change silently broke. Raises LabelsMovedError BEFORE writing anything if the label set moved — a moved label must never read as a rule regression." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="610" y="490" width="420" height="168" as="geometry" />
        </mxCell>
        <mxCell id="eval_w" value="evals/&amp;lt;eval_id&amp;gt;/&lt;br&gt;  outcomes.json&lt;br&gt;  metrics.jsonl&lt;br&gt;  regressions.csv&lt;br&gt;  eval_manifest.json&lt;br&gt;+ re-renders REPORT.md" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1040" y="490" width="250" height="168" as="geometry" />
        </mxCell>
        <mxCell id="eval_u" value="You want accuracy, or you want to know what a rule change actually moved. Regressions are LOGGED, not blocked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1300" y="490" width="260" height="168" as="geometry" />
        </mxCell>
        <mxCell id="labeltools_s" value="label_tools.py&lt;br&gt;&lt;br&gt;python3 label_tools.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="300" height="168" as="geometry" />
        </mxCell>
        <mxCell id="labeltools_r" value="labels/labels-initial.csv&lt;br&gt;obs-data/observations.csv&lt;br&gt;claims.yaml#fields (passed in at the entry point)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F1FA;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="672" width="250" height="168" as="geometry" />
        </mxCell>
        <mxCell id="labeltools_d" value="Converts the wide rendering into the long-format labels.csv everything else reads, and runs the transitivity check. Refuses to regenerate over adjudicated labels, and refuses a column that is neither wide-file metadata nor a declared field — a silently ignored column drops that field's whole ground truth." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="610" y="672" width="420" height="168" as="geometry" />
        </mxCell>
        <mxCell id="labeltools_w" value="labels/labels.csv&lt;br&gt;labels/VERSION&lt;br&gt;labels/archive/&lt;br&gt;labels/journal.jsonl&lt;br&gt;labels/last_label_state.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F1FA;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1040" y="672" width="250" height="168" as="geometry" />
        </mxCell>
        <mxCell id="labeltools_u" value="You edited labels-initial.csv. labels.csv is generated, never maintained by hand." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1300" y="672" width="260" height="168" as="geometry" />
        </mxCell>
        <mxCell id="adj_s" value="adjudicate.py&lt;br&gt;&lt;br&gt;python3 adjudicate.py runs/&amp;lt;run_id&amp;gt;&lt;br&gt;python3 adjudicate.py runs/&amp;lt;run_id&amp;gt; returned.csv" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="854" width="300" height="168" as="geometry" />
        </mxCell>
        <mxCell id="adj_r" value="resolutions.csv (to EXCLUDE what is settled)&lt;br&gt;labels/labels.csv&lt;br&gt;claims.yaml#fields" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F1FA;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="854" width="250" height="168" as="geometry" />
        </mxCell>
        <mxCell id="adj_d" value="EXPORT: an evidence-only packet for the medium/low certainty stratum — no resolved values, no confidence, so the adjudicator is asked &quot;what is this?&quot; rather than &quot;is this right?&quot;. IMPORT: two independent gates — rejected (inadmissible) and refused (does not supersede, per basis precedence)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="610" y="854" width="420" height="168" as="geometry" />
        </mxCell>
        <mxCell id="adj_w" value="adjudication/&amp;lt;run_id&amp;gt;/packet.csv&lt;br&gt;then, on import, all of labels/ above" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F1FA;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1040" y="854" width="250" height="168" as="geometry" />
        </mxCell>
        <mxCell id="adj_u" value="You need better ground truth where the labeller was unsure. An observation leaves the queue only when EVERY row it has is settled." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1300" y="854" width="260" height="168" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="The two guard rails, and why they point in opposite directions&lt;br&gt;&lt;br&gt;invariant #5 — labels never enter the runtime path.  run.py and everything it imports have no code path that reads labels/. This is why eval.py, label_tools.py and adjudicate.py live OUTSIDE obs_pipeline/: structural, not conventional. It is what stops the pipeline from doing better on labelled data than it would on new data.&lt;br&gt;&lt;br&gt;invariant #6 — pipeline output never enters hard-stratum label creation.  The mirror. In adjudicate.py, SELECTION may read pipeline output; PRESENTATION must not. A human handed a plausible answer and asked &quot;is this right?&quot; agrees more often than one asked &quot;what is this?&quot;, and unblinded labelling drifts ground truth toward whatever the pipeline already believes — worst precisely where it is confidently wrong." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1046" width="1520" height="168" as="geometry" />
        </mxCell>
        <mxCell id="order" value="Everyday order:   python3 -m pytest -q   →   python3 eval.py   →   python3 replay.py runs/&amp;lt;run_id&amp;gt;   →   read regressions.csv   →   bump rules/VERSION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="1228" width="1520" height="34" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
