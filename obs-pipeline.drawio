        <mxCell id="tracer" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B9D2F2;strokeColor=#3B6BA5;horizontal=0;fontSize=11;fontStyle=1;fontColor=#101010;" value="trace.py · Tracer  —  Traced[T] cannot be constructed except through Tracer.step(), so a code path that produces a value necessarily emitted one.  step_id is content-addressed, never a counter." vertex="1">
          <mxGeometry height="1058" width="36" x="346" y="132" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;1.  load_rules&lt;/b&gt;   &lt;i&gt;loader.py&lt;/i&gt;&lt;br&gt;Parse 6 YAML + vocab · cross-file validation raises CrossFileError at init, not three stages later · per-file + rollup hash · stale-bump check" vertex="1">
          <mxGeometry height="90" width="322" x="398" y="132" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;2.  load_observations&lt;/b&gt;   &lt;i&gt;extract.py + normalize.py&lt;/i&gt;&lt;br&gt;regex / OUI map / port signatures → MAC, hostname, vendor, device_type canonicalization · absence emits no_extraction" vertex="1">
          <mxGeometry height="90" width="322" x="398" y="238" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;3.  build_claims&lt;/b&gt;   &lt;i&gt;claims.py&lt;/i&gt;&lt;br&gt;keyed (obs_id, field | link_basis, value) · source is metadata ON the claim, never in the key · NOT vocab-constrained · absence emits no_identity_claim" vertex="1">
          <mxGeometry height="90" width="322" x="398" y="344" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;4.  resolve_entities&lt;/b&gt;   &lt;i&gt;entity.py&lt;/i&gt;&lt;br&gt;deterministic union-find · merge order pinned by entity_resolution.yaml, not by input order · basis-precedence tie-break · content-addressed entity_id · refusals emit merge_refused" vertex="1">
          <mxGeometry height="90" width="322" x="398" y="450" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;5.  resolve_fields&lt;/b&gt;   &lt;i&gt;fields.py&lt;/i&gt;&lt;br&gt;entity level · highest claim_weight wins · winner re-scored over POOLED witness groups across members · firmware conflict → undecidable · out-of-vocab emits vocab_reject" vertex="1">
          <mxGeometry height="90" width="322" x="398" y="556" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;6.  observation_fields&lt;/b&gt;   &lt;i&gt;fields.py&lt;/i&gt;&lt;br&gt;per observation · direct vs propagated provenance · multiplicative decay: source_conf × link_weight × decay_base^hop · Unknown never propagates" vertex="1">
          <mxGeometry height="90" width="322" x="398" y="662" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;7.  entity_confidence + stability&lt;/b&gt;   &lt;i&gt;confidence.py&lt;/i&gt;&lt;br&gt;harmonic mean across fields — the weakest field dominates · stability is a SEPARATE measure: margin, witness_dependence (a count), live_conflict" vertex="1">
          <mxGeometry height="90" width="322" x="398" y="768" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;8.  write_bundle&lt;/b&gt;   &lt;i&gt;bundle.py&lt;/i&gt;&lt;br&gt;manifest + 4 CSVs + trace.jsonl · rows stay narrow: each carries run_id and derivation_step rather than repeating rule versions" vertex="1">
          <mxGeometry height="90" width="322" x="398" y="874" as="geometry" />
        </mxCell>
        <mxCell id="s9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;9.  emit_metrics&lt;/b&gt;   &lt;i&gt;metrics.py&lt;/i&gt;&lt;br&gt;label-free metrics only · long format, one row per measurement, n mandatory · appended to runs/history.jsonl" vertex="1">
          <mxGeometry height="90" width="322" x="398" y="980" as="geometry" />
        </mxCell>
        <mxCell id="s10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2FA;strokeColor=#3B6BA5;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;10.  write_report&lt;/b&gt;   &lt;i&gt;report.py&lt;/i&gt;&lt;br&gt;REPORT.md is a derived render — regenerable, never hand-edited, and nothing may depend on parsing it" vertex="1">
          <mxGeometry height="90" width="322" x="398" y="1086" as="geometry" />
        </mxCell>
        <mxCell id="score" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFDDB0;strokeColor=#B87A00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#101010;" value="&lt;b&gt;scoring.py · score()&lt;/b&gt;&lt;br&gt;THE single scoring function.&lt;br&gt;&lt;br&gt;clamp(max_base + independence_bonus − conflict_penalty, 0, 1)&lt;br&gt;&lt;br&gt;Three coefficient sets, one formula shape." vertex="1">
          <mxGeometry height="210" width="150" x="770" y="394" as="geometry" />
        </mxCell>
